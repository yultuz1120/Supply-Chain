# 数据库
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=supply_chain_demo
MYSQL_USERNAME=root
MYSQL_PASSWORD=your-mysql-password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=10

# DeepSeek：只填写在本地环境中，不要提交真实密钥
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 已安装的 Milvus
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=supply_chain_knowledge

# 项目内置 MCP Streamable HTTP 服务
MCP_SERVER_URL=http://localhost:8080/mcp

# 部署时使用随机生成的高强度密钥
ADMIN_JWT_SECRET=replace-with-a-random-admin-secret
USER_JWT_SECRET=replace-with-a-random-user-secret
